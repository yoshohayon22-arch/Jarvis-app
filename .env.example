# Copie ce fichier en .env.local (en local) ou renseigne ces variables chez l'hébergeur (Netlify).
# Ne commite jamais .env.local.

# --- Connexion par mot de passe (mode actuel) ---
NEXT_PUBLIC_AUTH_MODE=motdepasse
# Clé de signature des sessions : au moins 32 caractères aléatoires. Variable serveur uniquement.
SESSION_SECRET=
# Empreinte du mot de passe (jamais le mot de passe). La calculer avec : node scripts/empreinte-mot-de-passe.mjs
PASSWORD_HASH=

# --- Supabase (plus tard, quand la base sera branchée) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# ALLOWED_EMAIL=ton.adresse@gmail.com

# --- Phase 1 (plus tard) ---
# Jeton gratuit football-data.org (onglet Real Madrid). Variable serveur uniquement.
FOOTBALL_DATA_TOKEN=
# ANTHROPIC_API_KEY=
