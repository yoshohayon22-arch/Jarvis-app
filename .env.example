# Copie ce fichier en .env.local (en local) ou renseigne ces variables dans Vercel
# (Project > Settings > Environment Variables). Ne commite jamais .env.local.

# Supabase > Project Settings > API (ou « Connect »)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_…) — publique par conception, protégée par la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Le seul compte Google autorisé à se connecter (en minuscules). Variable serveur uniquement.
ALLOWED_EMAIL=ton.adresse@gmail.com

# Phase 1 (plus tard)
# FOOTBALL_DATA_TOKEN=
# ANTHROPIC_API_KEY=
