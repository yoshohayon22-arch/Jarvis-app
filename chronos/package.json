{
  "name": "chronos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm run test -w client && npm run test -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "e2e": "node e2e/smoke.mjs",
    "server": "npm run start -w server",
    "dev:all": "node tools/dev.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@pmndrs/assets": "1.7.0",
    "meshoptimizer": "1.3.0"
  }
}